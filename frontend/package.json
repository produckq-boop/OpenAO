{
    "name": "falopita",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "protocol:build": "pnpm exec tsc -p ../packages/protocol/tsconfig.json",
        "predev": "pnpm run protocol:build",
        "dev": "next dev --turbopack --hostname 0.0.0.0",
        "prebuild": "pnpm run protocol:build",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run",
        "generate:headswithfile": "node ./scripts/generate-headswithfile.mjs"
    },
    "dependencies": {
        "@openao/protocol": "link:../packages/protocol",
        "dotenv": "^17.4.2",
        "howler": "^2.2.4",
        "lucide-react": "^1.16.0",
        "next": "^16.2.4",
        "pixi.js": "^8.17.1",
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.2.4",
        "@testing-library/react": "^16.3.3",
        "@types/howler": "^2.2.12",
        "@types/node": "^25.8.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.6",
        "jsdom": "^26.1.0",
        "tailwindcss": "^4.2.4",
        "typescript": "^6.0.3",
        "vitest": "^3.2.7"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "unrs-resolver"
        ]
    }
}
